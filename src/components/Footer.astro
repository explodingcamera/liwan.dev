---
import { Image } from "astro:assets";
import EditLink from "@astrojs/starlight/components/EditLink.astro";
import type StarlightFooter from "@astrojs/starlight/components/Footer.astro";
import LastUpdated from "@astrojs/starlight/components/LastUpdated.astro";
import Pagination from "@astrojs/starlight/components/Pagination.astro";

type Props = Parameters<typeof StarlightFooter>[0];

const { entry } = Astro.locals.starlightRoute;
const showBranding = entry.data.template !== "doc";
---

<footer class="sl-flex">
  <div class="meta sl-flex">
    <EditLink {...Astro.props} />
    <LastUpdated {...Astro.props} />
  </div>
  <Pagination {...Astro.props} />

  <div class="imprint sl-flex">
    {showBranding && (
      <h2>
        <span class="brand">
          <Image src="/favicon.svg" alt="liwan logo" width="20" height="20" />
          liwan
        </span>
        <span class="tagline">Self-hosted, privacy-first web analytics</span>
      </h2>
    )}
    <div class="contact-links">
      {showBranding && (
        <a href="mailto:hi@liwan.dev">hi@liwan.dev</a>
      )}
      <div class="legal-links">
        <a target="_blank" href="https://henrygressmann.de/impressum">
          imprint
        </a>
        <a target="_blank" href="https://henrygressmann.de/privacy">
          privacy policy
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    flex-direction: column;
    gap: 1.5rem;
  }
  .meta {
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-top: 3rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .meta > :global(p:only-child) {
    margin-inline-start: auto;
  }

  .imprint {
    display: flex;
    flex-direction: column;
    gap: 0.1em;

    h2 {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.25rem 0.75rem;
    }

    .brand {
      display: inline-flex;
      align-items: baseline;
      gap: 0.3em;
      white-space: nowrap;
    }

    .tagline {
      color: var(--sl-color-text);
      font-size: 1rem;
      font-weight: 400;
    }

    a {
      font-size: 1rem;
      color: var(--sl-color-gray-3);
      &:hover {
        color: var(--sl-color-white);
      }
    }
  }
  .imprint :global(svg) {
    color: var(--sl-color-orange);
  }
  .contact-links {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }
  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-inline-start: auto;
  }
  .kudos:hover {
    color: var(--sl-color-white);
  }
</style>

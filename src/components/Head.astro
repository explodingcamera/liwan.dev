---
import StarlightHead from "@astrojs/starlight/components/Head.astro";
---

<meta property="og:image" content="/og-image.png" />
<script>
  import { event, setProperties, trackPageviews } from "@liwan.dev/tracker";
  import type { EventProperties } from "@liwan.dev/tracker";

  const darkMode = matchMedia("(prefers-color-scheme: dark)");
  const updateTheme = () => setProperties({ device_theme: darkMode.matches ? "dark" : "light" });
  updateTheme();
  darkMode.addEventListener("change", updateTheme);

  const trackerOptions = { endpoint: "https://demo.liwan.dev/api/event", entity: "liwan.dev" };
  trackPageviews(trackerOptions);

  const track = (name: string, properties: EventProperties) => {
    void event(name, { ...trackerOptions, properties }).catch(() => {});
  };

  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Element)) return;
    const link = e.target.closest("a[href]");
    if (!(link instanceof HTMLAnchorElement)) return;

    if (link.href === "https://demo.liwan.dev/p/liwan.dev") {
      track("open-demo", { placement: link.closest(".hero-images") ? "screenshot" : "hero" });
    } else if (link.href === "https://github.com/explodingcamera/liwan") {
      track("open-github", {
        placement: link.closest("header") ? "header" : link.closest(".mobile-preferences") ? "menu" : "content",
      });
    }
  });

  window.addEventListener("liwan:theme-switch", (e) => {
    if (e instanceof CustomEvent && (e.detail === "light" || e.detail === "dark")) {
      track("switch-theme", { theme: e.detail });
    }
  });
</script>
<StarlightHead {...Astro.props} />
